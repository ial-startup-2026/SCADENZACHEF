# Copia in .env.local (gitignored) e compila. Non committare mai valori reali.

# Supabase (Fase 2) — Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo lato server / Edge Function. Mai esporla al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Lettura etichette (Fase 4) — solo lato server
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 = la route /api/scan restituisce dati finti (sviluppo e test E2E)
SCAN_MOCK=0

# Notifiche push (Fase 6) — chiavi VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# URL pubblico dell'app (link di invito, deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
